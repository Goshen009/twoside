generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
	id											String @id @default(uuid())
	name										String @unique
	timezone								String 

	created_at							DateTime @default(now()) @db.Timestamptz(6)
	updated_at							DateTime @updatedAt @db.Timestamptz(6)

	tags										Tag[]
	accounts								Account[]
}

model Tag {
	id											String @id @default(uuid())
	name										String
	lowercase_name					String

	created_at							DateTime @default(now()) @db.Timestamptz(6)
	updated_at							DateTime @updatedAt @db.Timestamptz(6)

	user_id									String
	user										User @relation(fields: [user_id], references: [id])

	@@unique([user_id, lowercase_name])
}

model Account {
	id											String @id @default(uuid())
	type										AccountType
	name										String

	created_at							DateTime @default(now()) @db.Timestamptz(6)
	updated_at							DateTime @updatedAt @db.Timestamptz(6)

	entries									Entries[]

	user_id									String
	user										User @relation(fields: [user_id], references: [id])
	
	@@unique([user_id, name])
}

enum AccountType {
	ASSET
	EXPENSE
}

model Transaction {
	id											String @id @default(uuid())

	description							String

	// You bought X yesterday but recorded it today. Transaction date will be yesterday. Created at will be today.
	// Transaction date is the date the transaction actually happened. Created at is the date the transaction was logged into the app.
	transaction_date				DateTime @db.Timestamptz(6)
	created_at							DateTime @default(now()) @db.Timestamptz(6)
	updated_at							DateTime @updatedAt @db.Timestamptz(6)

	entries									Entries[]
}

model Entries {
	id											String @id @default(uuid())

	side										AccountingSide
	amount									Decimal @db.Decimal(12, 2)

	account_id							String
	account									Account @relation(fields: [account_id], references: [id])
	
	transaction_id					String
	transaction							Transaction @relation(fields: [transaction_id], references: [id])
}

enum AccountingSide {
	CREDIT
	DEBIT
}