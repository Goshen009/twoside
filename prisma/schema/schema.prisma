generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
	id											String @id @default(uuid())
	name										String
	timezone								String 
	currency_symbol					String
	email										String?

	google_account_id				String @unique

	reminder_minutes  			Int @default(1200) // minutes since local midnight (1200 = 20:00)
  last_reminded_on  			String? // YYYY-MM-DD in the user's own timezone

	created_at							DateTime @default(now()) @db.Timestamptz(6)
	updated_at							DateTime @updatedAt @db.Timestamptz(6)

	tags										Tag[]
	accounts								Account[]
	app_opens								AppOpen[]
	transactions						Transaction[]
	refresh_tokens					RefreshToken[]
	webpush_subscriptions		WebPushSubscription[]
}

model AppOpen {
	id											String @id @default(uuid())
	device     							Device
  is_pwa     							Boolean
  created_at 							DateTime @default(now()) @db.Timestamptz(6)

	user_id    							String
  user      					 		User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
}

enum Device {
	IOS
	ANDROID
	DESKTOP
}

model WebPushSubscription {
  id              				String @id @default(uuid())
  endpoint        				String @unique // this is the device identifier
  p256dh          				String
  auth            				String
  
  created_at 							DateTime @default(now()) @db.Timestamptz(6)
  updated_at							DateTime @updatedAt @db.Timestamptz(6)

  user_id    							String
  user      					 		User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model RefreshToken {
  id         						String @id @default(uuid())
  token_hash 						String @unique

  expires_at 						DateTime @db.Timestamptz(6)
  created_at 						DateTime @default(now()) @db.Timestamptz(6)

  user_id    						String
  user      					 	User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Tag {
	id											String @id @default(uuid())
	name										String
	lowercase_name					String

	created_at							DateTime @default(now()) @db.Timestamptz(6)
	updated_at							DateTime @updatedAt @db.Timestamptz(6)

	transactions						Transaction[]

	user_id									String
	user										User @relation(fields: [user_id], references: [id])

	@@unique([user_id, lowercase_name])
}

model Account {
	id											String @id @default(uuid())
	type										AccountType
	name										String

	created_at							DateTime @default(now()) @db.Timestamptz(6)
	updated_at							DateTime @updatedAt @db.Timestamptz(6)

	entries									Entries[]

	user_id									String
	user										User @relation(fields: [user_id], references: [id])
	
	@@unique([user_id, name])
}

enum AccountType {
	ASSET
	EXPENSE
}

model Transaction {
	id											String @id @default(uuid())

	description							String

	// You bought X yesterday but recorded it today. Transaction date will be yesterday. Created at will be today.
	// Transaction date is the date the transaction actually happened. Created at is the date the transaction was logged into the app.
	transaction_date				DateTime @db.Timestamptz(6)
	created_at							DateTime @default(now()) @db.Timestamptz(6)
	updated_at							DateTime @updatedAt @db.Timestamptz(6)

	entries									Entries[]

	tag_id									String?
	tag											Tag? @relation(fields: [tag_id], references: [id], onDelete: SetNull)

	user_id									String
	user										User @relation(fields: [user_id], references: [id])
}

model Entries {
	id											String @id @default(uuid())

	side										AccountingSide
	amount									Decimal @db.Decimal(12, 2)

	account_id							String
	account									Account @relation(fields: [account_id], references: [id])
	
	transaction_id					String
	transaction							Transaction @relation(fields: [transaction_id], references: [id])
}

enum AccountingSide {
	CREDIT
	DEBIT
}